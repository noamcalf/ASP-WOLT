# Example Environment Configuration
# This file demonstrates how secrets and environment variables should be configured in a production environment.
# Note: For this academic project, we use defaults in docker-compose.yml for grader convenience.

# Backend Configuration
PORT=3000
NODE_ENV=production

# Database
MONGO_URI=mongodb://mongodb:27017/wolt_db

# Security Secrets
# Change this to a secure random string in production!
JWT_SECRET=YOUR_SUPER_SECRET_PRODUCTION_KEY

# C++ Microservice
CPP_BACKEND_URL=http://cpp_backend:8080
